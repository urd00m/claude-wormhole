# Slack app-level token (xapp-...) — needs connections:write
SLACK_APP_TOKEN=xapp-...

# Slack bot OAuth token (xoxb-...) — install the app to your workspace to get this
SLACK_BOT_TOKEN=xoxb-...

# Slack signing secret (from Basic Information)
SLACK_SIGNING_SECRET=

# Claude auth — pick ONE of the following:
#   (a) Set ANTHROPIC_API_KEY below, OR
#   (b) Leave ANTHROPIC_API_KEY blank/unset and run `npm run login` to
#       authenticate against your Claude Pro/Max subscription via OAuth.
#       Credentials get stored at ~/.claude/ and the SDK uses them automatically.
ANTHROPIC_API_KEY=

# Optional: override default Claude model
ANTHROPIC_MODEL=claude-opus-4-7

# Multi-account credential pool — balance usage across Claude subscriptions.
# Comma-separated list of credential directories (each a ~/.claude/-style dir
# containing .credentials.json from `claude login`). When set, each turn
# picks the least-recently-used available account, auto-skipping any that
# hit their rate limit. Leave blank for single-account mode.
#
# To add an account:
#   CLAUDE_CONFIG_DIR=~/.claude-acct2 npx @anthropic-ai/claude-code login
# Then add the path here:
#   CLAUDE_CREDENTIAL_DIRS=~/.claude-acct1,~/.claude-acct2,~/.claude-acct3
CLAUDE_CREDENTIAL_DIRS=

# Codex auth — only needed if you want threads backed by OpenAI Codex
# instead of Claude. Pick ONE:
#   (a) Set OPENAI_API_KEY below, OR
#   (b) Leave OPENAI_API_KEY blank/unset and run `codex login` to
#       authenticate against your ChatGPT / Codex subscription. Credentials
#       get stashed at ~/.codex/ and the Codex CLI uses them automatically.
# If you only ever use Claude, leave this blank.
OPENAI_API_KEY=

# Optional: override the Codex model. Leave BLANK to let codex pick its
# own default (recommended — works across both ChatGPT subscription and
# API key auth). Setting this passes `-m <value>` to `codex exec`.
# Note: `gpt-5-codex` is rejected under ChatGPT subscription auth; reach
# for it only if you're on an API key and want to pin a specific model.
OPENAI_MODEL=

# Default runtime for new threads. A per-thread override (set via the
# runtime-switch control phrase in Slack — "switch to codex" / "use claude" —
# persisted in data/runtimes.json) wins when present.
#   claude — Claude Agent SDK (default)
#   codex  — OpenAI Codex CLI
DEFAULT_RUNTIME=claude

# Optional: log level
LOG_LEVEL=info
