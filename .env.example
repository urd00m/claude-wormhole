# Slack app-level token (xapp-...) — needs connections:write
SLACK_APP_TOKEN=xapp-...

# Slack bot OAuth token (xoxb-...) — install the app to your workspace to get this
SLACK_BOT_TOKEN=xoxb-...

# Slack signing secret (from Basic Information)
SLACK_SIGNING_SECRET=

# Claude auth — pick ONE of the following:
#   (a) Set ANTHROPIC_API_KEY below, OR
#   (b) Leave ANTHROPIC_API_KEY blank/unset and run `npm run login` to
#       authenticate against your Claude Pro/Max subscription via OAuth.
#       Credentials get stored at ~/.claude/ and the SDK uses them automatically.
ANTHROPIC_API_KEY=

# Optional: override default model
ANTHROPIC_MODEL=claude-opus-4-7

# Optional: log level
LOG_LEVEL=info
